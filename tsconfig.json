{
	"include": ["**/*.ts", "**/*.tsx"],
	"compilerOptions": {
		"jsx": "react-jsx",
		"moduleResolution": "Bundler",
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"allowJs": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"module": "ESNext",
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"skipLibCheck": true,
		"strictNullChecks": true,
		"paths": {
			"@/*": ["./src/*"],
			"shared/*": ["./shared/*"],
			"#/*": ["./convex/*"]
		},
		"noEmit": true
	}
}
