  "scripts": {
    "build": "bun --bun vite build",
    "check": "oxlint && oxfmt",
    "deploy:convex": "convex deploy",
    "dev": "bun run --parallel dev:stack dev:convex",
    "dev:stack": "bun --bun vite dev --port 3000",
    "dev:convex": "convex dev --typecheck-components",
    "format": "oxfmt",
    "lint": "oxlint --type-aware",
    "preview": "bun --bun vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
