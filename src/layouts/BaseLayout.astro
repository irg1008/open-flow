---
import HeadSEO from "@/components/HeadSEO.astro";
import { Navbar } from "@/components/Navbar";
import ThemeMode from "@/components/ThemeMode.astro";
import { Toaster } from "@/components/ui/sonner";
import I18nHead from "@zachhandley/ez-i18n/astro";
import { ClientRouter } from "astro:transitions";

const { title, description, keywords, ogImage } = Astro.props;
const { locale, translations } = Astro.locals;
---

<!doctype html>
<html lang={locale}>
	<head>
		<ClientRouter />
		<HeadSEO
			title={title}
			description={description}
			keywords={keywords}
			ogImage={ogImage}
		/>
		<I18nHead locale={locale} translations={translations} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<ThemeMode />

		<!-- <script
			defer
			is:inline
			type="text/partytown"
			src="https://track.rincondelasella.com/api/script.js"
			data-track-errors="true"
			data-site-id="1"></script> -->
	</head>
	<body
		class="group/body overscroll-none antialiased [--footer-height:calc(var(--spacing)*14)] [--header-height:calc(var(--spacing)*14)] xl:[--footer-height:calc(var(--spacing)*24)]"
	>
		<div class="bg-background relative flex min-h-svh flex-col">
			<Navbar client:load />
			<main class="relative flex flex-1 flex-col">
				<slot />
			</main>
		</div>
		<Toaster client:load />
	</body>
</html>
