---
import BaseLayout from "@/layouts/BaseLayout.astro";

const { t } = Astro.locals;
---

<BaseLayout
	title={t("pages.not-found.meta.title")}
	description={t("pages.not-found.meta.description")}
>
	<div
		class="bg-background flex min-h-[calc(100svh-var(--header-height))] items-center justify-center px-4"
	>
		<div class="text-center">
			<h1
				class="glitch text-foreground font-mono text-7xl font-bold tracking-tight sm:text-8xl md:text-9xl"
				data-text="404"
			>
				404
			</h1>
			<p class="text-muted-foreground mt-4 font-mono text-sm">
				{t("pages.not-found.message")}
			</p>
			<a
				href="/"
				class="mt-6 inline-block font-mono text-sm underline underline-offset-4"
			>
				{t("pages.not-found.action")}
			</a>
		</div>
	</div>
</BaseLayout>

<style>
	.glitch {
		position: relative;
		display: inline-block;
	}

	.glitch::before,
	.glitch::after {
		content: attr(data-text);
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		overflow: hidden;
		pointer-events: none;
	}

	.glitch::before {
		text-shadow: -1px 0 #00ffff;
		animation: glitch-left 1.6s infinite cubic-bezier(0.4, 0, 0.2, 1)
			alternate-reverse;
	}

	.glitch::after {
		text-shadow: 1px 0 #ff00ff;
		animation: glitch-right 1.3s infinite cubic-bezier(0.4, 0, 0.2, 1)
			alternate-reverse;
	}

	@keyframes glitch-left {
		0% {
			clip-path: inset(10% 0 75% 0);
			transform: translateX(0);
		}
		25% {
			clip-path: inset(45% 0 35% 0);
			transform: translateX(-1px);
		}
		50% {
			clip-path: inset(70% 0 15% 0);
			transform: translateX(1px);
		}
		75% {
			clip-path: inset(20% 0 55% 0);
			transform: translateX(-1px);
		}
		100% {
			clip-path: inset(5% 0 85% 0);
			transform: translateX(0);
		}
	}

	@keyframes glitch-right {
		0% {
			clip-path: inset(80% 0 5% 0);
			transform: translateX(0);
		}
		25% {
			clip-path: inset(30% 0 45% 0);
			transform: translateX(1px);
		}
		50% {
			clip-path: inset(55% 0 25% 0);
			transform: translateX(-1px);
		}
		75% {
			clip-path: inset(12% 0 68% 0);
			transform: translateX(1px);
		}
		100% {
			clip-path: inset(42% 0 38% 0);
			transform: translateX(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.glitch::before,
		.glitch::after {
			animation: none;
		}
	}
</style>
