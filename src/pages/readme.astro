---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { parseRemoteGithubMarkdown } from "@/lib/markdown";
import "highlight.js/styles/github-dark.css";

const user = Astro.url.searchParams.get("user");
const repo = Astro.url.searchParams.get("repo");
const branch = Astro.url.searchParams.get("branch") || "main";

if (!user || !repo) {
	return Astro.redirect("/404");
}

const markdownContent = await parseRemoteGithubMarkdown(user, repo, branch);
---

<BaseLayout>
	{
		markdownContent ? (
			<article set:html={markdownContent} class="typography container" />
		) : (
			<p>Show description or show fallback empty description and markdown</p>
		)
	}
</BaseLayout>
