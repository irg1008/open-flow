{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"experimentalSortPackageJson": true,
	"experimentalTailwindcss": {
		"functions": ["clsx", "cn", "cva", "tw"]
	},
	"ignorePatterns": [
		"*.min.*",
		"*.map",
		"**/public",
		"**/build",
		"**/dist",
		"**/out",
		"**/.github",
		"**/.next",
		"**/.netlify",
		"**/package.json",
		"**/.tanstack",
		"**/routeTree.gen.ts"
	],
	"jsxSingleQuote": false,
	"singleQuote": false,
	"trailingComma": "none"
}
