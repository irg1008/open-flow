{
	"servers": {
		"tanstack": {
			"command": "npx",
			"args": ["@tanstack/cli", "mcp"]
		},
		"convex-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": ["-y", "convex@latest", "mcp", "start"]
		},
		"better-auth": {
			"url": "https://mcp.inkeep.com/better-auth/mcp"
		},
		"shadcn": {
			"command": "npx",
			"args": ["shadcn@latest", "mcp"]
		}
	}
}
